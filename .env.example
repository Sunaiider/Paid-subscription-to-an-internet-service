# Copiar a .env y reemplazar con tus claves de Stripe en modo test
STRIPE_SECRET_KEY=sk_test_abc123
STRIPE_WEBHOOK_SECRET=whsec_...
# URL base usada para success/cancel (en local con Stripe CLI: http://localhost:4242)
DOMAIN=http://localhost:4242
PORT=4242
# Price IDs creados en Stripe Dashboard (Productos -> Precios)
# Ejemplo: price_1NabcXYZ...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_FAMILY=price_...
# Token simple para acceder al panel admin (demo). En producción use auth real.
ADMIN_TOKEN=changeme_admin_token
